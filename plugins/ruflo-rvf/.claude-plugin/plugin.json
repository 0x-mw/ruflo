{
  "name": "ruflo-rvf",
  "description": "이식 가능한 에이전트 메모리, 세션 영속화, 플랫폼 간 전송을 위한 RVF 형식. mod(ADR-445)로서 비밀이 메모리, 세션, 전송에 들어가지 않게 하는 쓰기 가드, /rvf-mod, 콘솔이 보여 주는 상태 파일을 제공",
  "version": "0.3.5",
  "author": {
    "name": "ruvnet",
    "url": "https://github.com/ruvnet"
  },
  "homepage": "https://github.com/ruvnet/ruflo",
  "license": "MIT",
  "keywords": [
    "ruflo",
    "rvf",
    "memory",
    "session",
    "persistence",
    "transfer",
    "mcp",
    "cognitive-containers",
    "lineage-tracking",
    "mod",
    "function-hooks",
    "guard"
  ],
  "userConfig": {
    "guard": {
      "type": "string",
      "title": "비밀 가드",
      "description": "키, 토큰, 비밀번호가 들어 있는, 이 플러그인 쓰기 도구 호출을 거부합니다.",
      "required": false,
      "default": "on",
      "options": [
        "on",
        "off"
      ]
    }
  }
}
